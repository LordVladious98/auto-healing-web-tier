@"
# Terraform working directory
.terraform/

# Terraform state
*.tfstate
*.tfstate.*

# Terraform plans
*.tfplan

# Crash logs
crash.log
crash.*.log

# Variable files that may contain secrets
*.tfvars
*.tfvars.json

# Terraform CLI config
.terraformrc
terraform.rc

# Local environment files
.env
.env.*

# Editor / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
"@ | Set-Content .gitignore